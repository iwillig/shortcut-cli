openapi: 3.0.0
components:
  securitySchemes:
    api_token: {name: Shortcut-Token, type: apiKey, in: header}
  schemas:
    HistoryActionStoryCreate:
      properties:
        parent_story_id: {type: integer, description: The Story's Parent ID (only applicable if Story is a Sub-task), format: int64}
        deadline: {type: string, description: The timestamp representing the Story's deadline.}
        started: {type: boolean, description: Whether or not the Story has been started.}
        blocker: {type: boolean, description: Whether or not the Story is blocking another Story.}
        requested_by_id: {type: string, description: The ID of the Member that requested the Story., format: uuid}
        app_url: {maxLength: 2048, pattern: '^https?://.+$', type: string, description: The application URL of the Story.}
        story_type:
          type: string
          description: The type of Story; either feature, bug, or chore.
          enum: [feature, chore, bug]
        estimate: {type: integer, description: The estimate (or point value) for the Story., format: int64}
        group_id: {type: string, description: The Team IDs for the followers of the Story., format: uuid}
        id: {type: integer, description: The ID of the entity referenced., format: int64}
        completed: {type: boolean, description: Whether or not the Story is completed.}
        owner_ids:
          items: {type: string, format: uuid}
          type: array
          description: An array of Member IDs that are the owners of the Story.
        follower_ids:
          items: {type: string, format: uuid}
          type: array
          description: An array of Member IDs for the followers of the Story.
        iteration_id: {nullable: true, type: integer, description: The Iteration ID the Story is in., format: int64}
        epic_id: {type: integer, description: The Epic ID for this Story., format: int64}
        object_story_link_ids:
          items: {type: integer, format: int64}
          type: array
          description: An array of Story IDs that are the object of a Story Link relationship.
        name: {type: string, description: The name of the Story.}
        custom_field_value_ids:
          items: {type: string, format: uuid}
          type: array
          description: An array of Custom Field Enum Value ids on this Story.
        label_ids:
          items: {type: integer, format: int64}
          type: array
          description: An array of Labels IDs attached to the Story.
        action:
          type: string
          description: The action of the entity referenced.
          enum: [create]
        project_id: {type: integer, description: The Project ID of the Story is in., format: int64}
        workflow_state_id: {type: integer, description: An array of Workflow State IDs attached to the Story., format: int64}
        task_ids:
          items: {type: integer, format: int64}
          type: array
          description: An array of Task IDs on this Story.
        blocked: {type: boolean, description: Whether or not the Story is blocked by another Story.}
        subject_story_link_ids:
          items: {type: integer, format: int64}
          type: array
          description: An array of Story IDs that are the subject of a Story Link relationship.
        entity_type: {type: string, description: The type of entity referenced.}
        description: {type: string, description: The description of the Story.}
      required: [app_url, entity_type, story_type, name, id, action]
      type: object
      additionalProperties: false
      description: An action representing a Story being created.
    Objective:
      properties:
        started: {type: boolean, description: A true/false boolean indicating if the Objective has been started.}
        completed_at_override: {nullable: true, type: string, description: A manual override for the time/date the Objective was completed., format: date-time}
        app_url: {type: string, description: The Shortcut application url for the Objective.}
        id: {type: integer, description: The unique ID of the Objective., format: int64}
        completed: {type: boolean, description: A true/false boolean indicating if the Objectivehas been completed.}
        categories:
          items: {$ref: '#/components/schemas/Category'}
          type: array
          description: An array of Categories attached to the Objective.
        started_at: {nullable: true, type: string, description: The time/date the Objective was started., format: date-time}
        position: {type: integer, description: A number representing the position of the Objective in relation to every other Objective within the Workspace., format: int64}
        name: {type: string, description: The name of the Objective.}
        archived: {type: boolean, description: A boolean indicating whether the Objective has been archived or not.}
        updated_at: {type: string, description: The time/date the Objective was updated., format: date-time}
        started_at_override: {nullable: true, type: string, description: A manual override for the time/date the Objective was started., format: date-time}
        state: {type: string, description: The workflow state that the Objective is in.}
        key_result_ids:
          items: {type: string, format: uuid}
          type: array
          description: The IDs of the Key Results associated with the Objective.
        created_at: {type: string, description: The time/date the Objective was created., format: date-time}
        global_id: {type: string, x-doc-skip: true}
        entity_type: {type: string, description: A string description of this resource.}
        stats: {$ref: '#/components/schemas/ObjectiveStats'}
        completed_at: {nullable: true, type: string, description: The time/date the Objective was completed., format: date-time}
        description: {type: string, description: The Objective's description.}
      required: [app_url, description, archived, started, entity_type, completed_at_override, started_at, completed_at, name, global_id, completed, state, started_at_override, updated_at, categories, id, key_result_ids, position, stats, created_at]
      type: object
      additionalProperties: false
      description: An Objective is a collection of Epics that represent a release or some other large initiative that you are working on.
    HistoryActionBranchMerge:
      properties:
        url: {type: string, description: The URL from the provider of the VCS Branch that was pushed}
        id: {type: integer, description: The ID of the entity referenced., format: int64}
        name: {type: string, description: The name of the VCS Branch that was pushed}
        action:
          type: string
          description: The action of the entity referenced.
          enum: [merge]
        entity_type: {type: string, description: The type of entity referenced.}
      required: [id, entity_type, name, url, action]
      type: object
      additionalProperties: false
      description: An action representing a VCS Branch being merged.
    StoryComment:
      properties:
        blocker: {type: boolean, description: Marks the comment as a blocker that can be surfaced to permissions or teams mentioned in the comment. Can only be used on a top-level comment.}
        app_url: {type: string, description: The Shortcut application url for the Comment.}
        author_id: {nullable: true, type: string, description: The unique ID of the Member who is the Comment's author., format: uuid}
        external_id: {nullable: true, type: string, description: 'This field can be set to another unique ID. In the case that the Comment has been imported from another tool, the ID in the other tool can be indicated here.'}
        reactions:
          items: {$ref: '#/components/schemas/StoryReaction'}
          type: array
          x-doc-skip: true
          description: A set of Reactions to this Comment.
        id: {type: integer, description: The unique ID of the Comment., format: int64}
        mention_ids:
          items: {type: string, format: uuid}
          type: array
          description: '`Deprecated:` use `member_mention_ids`.'
        member_mention_ids:
          items: {type: string, format: uuid}
          type: array
          description: The unique IDs of the Member who are mentioned in the Comment.
        position: {type: integer, description: The Comments numerical position in the list from oldest to newest., format: int64}
        updated_at: {nullable: true, type: string, description: The time/date when the Comment was updated., format: date-time}
        group_mention_ids:
          items: {type: string, format: uuid}
          type: array
          description: The unique IDs of the Group who are mentioned in the Comment.
        text: {nullable: true, type: string, description: 'The text of the Comment. In the case that the Comment has been deleted, this field can be set to nil.'}
        linked_to_slack: {type: boolean, description: Whether the Comment is currently the root of a thread that is linked to Slack.}
        story_id: {type: integer, description: The ID of the Story on which the Comment appears., format: int64}
        deleted: {type: boolean, description: True/false boolean indicating whether the Comment has been deleted.}
        parent_id: {nullable: true, type: integer, description: The ID of the parent Comment this Comment is threaded under., format: int64}
        created_at: {type: string, description: The time/date when the Comment was created., format: date-time}
        unblocks_parent: {type: boolean, description: Marks the comment as an unblocker to its  blocker parent. Can only be set on a threaded comment who has a parent with `blocker` set.}
        entity_type: {type: string, description: A string description of this resource.}
      required: [app_url, entity_type, deleted, story_id, mention_ids, author_id, member_mention_ids, linked_to_slack, updated_at, group_mention_ids, external_id, id, position, reactions, created_at, text]
      type: object
      additionalProperties: false
      description: A Comment is any note added within the Comment field of a Story.
    ProjectStats:
      properties:
        num_points: {type: integer, description: The total number of points in this Project., format: int64}
        num_stories: {type: integer, description: The total number of stories in this Project., format: int64}
        num_related_documents: {type: integer, description: The total number of documents related to this Project, format: int64}
      required: [num_stories, num_points, num_related_documents]
      type: object
      additionalProperties: false
      description: A group of calculated values for this Project.
    UpdateStoryContents:
      properties:
        sub_tasks:
          items: {$ref: '#/components/schemas/CreateSubTaskParams'}
          type: array
          description: |-
            An array of maps specifying the sub-tasks to create and link to the story.
            Field only applicable when Sub-task feature is enabled.
        deadline: {nullable: true, type: string, description: The due date of the story., format: date-time}
        tasks:
