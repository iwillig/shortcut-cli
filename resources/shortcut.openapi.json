security:
- api_token: []
servers:
- {url: 'https://api.app.shortcut.com'}
info: {title: Shortcut API, version: '3.0', description: Shortcut API}
paths:
  /api/v3/epic-workflow:
    get:
      operationId: getEpicWorkflow
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/EpicWorkflow'}
          description: Resource
      summary: Get Epic Workflow
      description: Returns the Epic Workflow for the Workspace.
  /api/v3/files:
    post:
      operationId: uploadFiles
      responses:
        '422': {description: Unprocessable}
        '201':
          content:
            application/json:
              schema:
                items: {$ref: '#/components/schemas/UploadedFile'}
                type: array
          description: Resource
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
      summary: Upload Files
      requestBody:
        content:
          multipart/form-data:
            schema:
              properties:
                file0: {type: string, description: A file upload. At least one is required., format: binary}
                file2: {type: string, description: Optional additional files., format: binary}
                story_id: {type: integer, description: The story ID that these files will be associated with., format: int64}
                file3: {type: string, description: Optional additional files., format: binary}
                file1: {type: string, description: Optional additional files., format: binary}
              required: [file0]
              type: object
      description: |-
        Upload Files uploads one or many files and optionally associates them with a story.
           Use the multipart/form-data content-type to upload.
           Each `file` key should contain a separate file.
           Each UploadedFile's name comes from the Content-Disposition header "filename" directive for that field.
    get:
      operationId: listFiles
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema:
                items: {$ref: '#/components/schemas/UploadedFile'}
                type: array
          description: Resource
      summary: List Files
      description: List Files returns a list of all UploadedFiles in the workspace.
  /api/v3/files/{file-public-id}:
    delete:
      operationId: deleteFile
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '204': {description: No Content}
      summary: Delete File
      parameters:
      - schema: {type: integer, format: int64}
        name: file-public-id
        required: true
        description: The File’s unique ID.
        in: path
      description: Delete File deletes a previously uploaded file.
    put:
      operationId: updateFile
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/UploadedFile'}
          description: Resource
      summary: Update File
      requestBody:
        content:
          application/json:
            schema: {$ref: '#/components/schemas/UpdateFile'}
        required: true
      parameters:
      - schema: {type: integer, format: int64}
        name: file-public-id
        required: true
        description: The unique ID assigned to the file in Shortcut.
        in: path
      description: Update File updates the properties of an UploadedFile (but not its content).
    get:
      operationId: getFile
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/UploadedFile'}
          description: Resource
      summary: Get File
      parameters:
      - schema: {type: integer, format: int64}
        name: file-public-id
        required: true
        description: The File’s unique ID.
        in: path
      description: Get File returns information about the selected UploadedFile.
  /api/v3/integrations/webhook:
    post:
      operationId: createGenericIntegration
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '204': {description: No Content}
      summary: Create Generic Integration
      requestBody:
        content:
          application/json:
            schema: {$ref: '#/components/schemas/CreateGenericIntegration'}
        required: true
  /api/v3/labels/{label-public-id}/epics:
    get:
      operationId: listLabelEpics
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema:
                items: {$ref: '#/components/schemas/EpicSlim'}
                type: array
          description: Resource
      summary: List Label Epics
      parameters:
      - schema: {type: integer, format: int64}
        name: label-public-id
        required: true
        description: The unique ID of the Label.
        in: path
      description: List all of the Epics with the Label.
  /api/v3/story-links/{story-link-public-id}:
    delete:
      operationId: deleteStoryLink
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '204': {description: No Content}
      summary: Delete Story Link
      parameters:
      - schema: {type: integer, format: int64}
        name: story-link-public-id
        required: true
        description: The unique ID of the Story Link.
        in: path
      description: Removes the relationship between the stories for the given Story Link.
    put:
      operationId: updateStoryLink
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/StoryLink'}
          description: Resource
      summary: Update Story Link
      requestBody:
        content:
          application/json:
            schema: {$ref: '#/components/schemas/UpdateStoryLink'}
        required: true
      parameters:
      - schema: {type: integer, format: int64}
        name: story-link-public-id
        required: true
        description: The unique ID of the Story Link.
        in: path
      description: Updates the stories and/or the relationship for the given Story Link.
    get:
      operationId: getStoryLink
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/StoryLink'}
          description: Resource
      summary: Get Story Link
      parameters:
      - schema: {type: integer, format: int64}
        name: story-link-public-id
        required: true
        description: The unique ID of the Story Link.
        in: path
      description: Returns the stories and their relationship for the given Story Link.
  /api/v3/custom-fields/{custom-field-public-id}:
    delete:
      operationId: deleteCustomField
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '204': {description: No Content}
      summary: Delete Custom Field
      parameters:
      - schema: {type: string, format: uuid}
        name: custom-field-public-id
        required: true
        description: The unique ID of the CustomField.
        in: path
    put:
      operationId: updateCustomField
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/CustomField'}
          description: Resource
        '409':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/DataConflictError'}
          description: ''
      summary: Update Custom Field
      requestBody:
        content:
          application/json:
            schema: {$ref: '#/components/schemas/UpdateCustomField'}
        required: true
      parameters:
      - schema: {type: string, format: uuid}
        name: custom-field-public-id
        required: true
        description: The unique ID of the CustomField.
        in: path
      description: 'Update Custom Field can be used to update the definition of a Custom Field. The order of items in the ''values'' collection is interpreted to be their ascending sort order.To delete an existing enum value, simply omit it from the ''values'' collection. New enum values may be created inline by including an object in the ''values'' collection having a ''value'' entry with no ''id'' (eg. {''value'': ''myNewValue'', ''color_key'': ''green''}).'
    get:
      operationId: getCustomField
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/CustomField'}
          description: Resource
      summary: Get Custom Field
      parameters:
      - schema: {type: string, format: uuid}
        name: custom-field-public-id
        required: true
        description: The unique ID of the CustomField.
        in: path
  /api/v3/health/{health-public-id}:
    put:
      operationId: updateHealth
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/Health'}
          description: Resource
      summary: Update Health
      requestBody:
        content:
          application/json:
            schema: {$ref: '#/components/schemas/UpdateHealth'}
        required: true
      parameters:
      - schema: {type: string, format: uuid}
        name: health-public-id
        required: true
        description: The unique ID of the Health record.
        in: path
      description: Update an existing health status by its ID.
  /api/v3/iterations/disable:
    put:
      operationId: disableIterations
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '204': {description: No Content}
      summary: Disable Iterations
      description: Disables Iterations for the current workspace
  /api/v3/projects:
    post:
      operationId: createProject
      responses:
        '422': {description: Unprocessable}
        '201':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/Project'}
          description: Resource
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
      summary: Create Project
      requestBody:
        content:
          application/json:
            schema: {$ref: '#/components/schemas/CreateProject'}
        required: true
      description: Create Project is used to create a new Shortcut Project.
    get:
      operationId: listProjects
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema:
                items: {$ref: '#/components/schemas/Project'}
                type: array
          description: Resource
      summary: List Projects
      description: List Projects returns a list of all Projects and their attributes.
  /api/v3/search:
    get:
      operationId: search
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/MaxSearchResultsExceededError'}
          description: '**Either:** (1) Schema mismatch **or** (2) Maximum of 1000 search results exceeded '
        '200':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/SearchResults'}
          description: Resource
      summary: Search
      parameters:
      - schema: {minLength: 1, type: string}
        name: query
        required: true
        description: See our help center article on [search operators](https://help.shortcut.com/hc/en-us/articles/360000046646-Search-Operators)
        in: query
      - schema: {type: integer, format: int64}
        name: page_size
        required: false
        description: The number of search results to include in a page. Minimum of 1 and maximum of 250.
        in: query
      - schema:
          type: string
          enum: [full, slim]
        name: detail
        required: false
        description: |-
          The amount of detail included in each result item.
             "full" will include all descriptions and comments and more fields on
             related items such as pull requests, branches and tasks.
             "slim" omits larger fulltext fields such as descriptions and comments
             and only references related items by id.
             The default is "full".
        in: query
      - schema: {type: string}
        name: next
        required: false
        description: The next page token.
        in: query
      - schema:
          items:
            type: string
            enum: [story, milestone, epic, iteration, objective]
          type: array
        name: entity_types
        explode: true
        required: false
        description: 'A collection of entity_types to search. Defaults to story and epic. Supports: epic, iteration, objective, story.'
        in: query
      description: Search lets you search Epics and Stories based on desired parameters. Since ordering of the results can change over time (due to search ranking decay, new Epics and Stories being created), the `next` value from the previous response can be used as the path and query string for the next page to ensure stable ordering.
  /api/v3/iterations:
    post:
      operationId: createIteration
      responses:
        '422': {description: Unprocessable}
        '201':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/Iteration'}
          description: Resource
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
      summary: Create Iteration
      requestBody:
        content:
          application/json:
            schema: {$ref: '#/components/schemas/CreateIteration'}
        required: true
    get:
      operationId: listIterations
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema:
                items: {$ref: '#/components/schemas/IterationSlim'}
                type: array
          description: Resource
      summary: List Iterations
  /api/v3/projects/{project-public-id}/stories:
    get:
      operationId: listStories
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema:
                items: {$ref: '#/components/schemas/StorySlim'}
                type: array
          description: Resource
      summary: List Stories
      parameters:
      - schema: {type: integer, format: int64}
        name: project-public-id
        required: true
        description: The unique ID of the Project.
        in: path
      - schema: {type: boolean}
        name: includes_description
        required: false
        description: A true/false boolean indicating whether to return Stories with their descriptions.
        in: query
      description: List Stories returns a list of all Stories in a selected Project and their attributes.
  /api/v3/entity-templates:
    post:
      operationId: createEntityTemplate
      responses:
        '422': {description: Unprocessable}
        '201':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/EntityTemplate'}
          description: Resource
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
      summary: Create Entity Template
      requestBody:
        content:
          application/json:
            schema: {$ref: '#/components/schemas/CreateEntityTemplate'}
        required: true
        description: Request parameters for creating an entirely new entity template.
      description: Create a new entity template for the Workspace.
    get:
      operationId: listEntityTemplates
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema:
                items: {$ref: '#/components/schemas/EntityTemplate'}
                type: array
          description: Resource
      summary: List Entity Templates
      description: List all the entity templates for the Workspace.
  /api/v3/members/{member-public-id}:
    get:
      operationId: getMember
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/Member'}
          description: Resource
      summary: Get Member
      parameters:
      - schema: {type: string, format: uuid}
        name: member-public-id
        required: true
        description: The Member's unique ID.
        in: path
      - schema: {type: string, format: uuid}
        name: org-public-id
        required: false
        x-doc-skip: true
        description: The unique ID of the Organization to limit the lookup to.
        in: query
      description: Returns information about a Member.
  /api/v3/entity-templates/{entity-template-public-id}:
    delete:
      operationId: deleteEntityTemplate
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '204': {description: No Content}
      summary: Delete Entity Template
      parameters:
      - schema: {type: string, format: uuid}
        name: entity-template-public-id
        required: true
        description: The unique ID of the entity template.
        in: path
    put:
      operationId: updateEntityTemplate
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/EntityTemplate'}
          description: Resource
      summary: Update Entity Template
      requestBody:
        content:
          application/json:
            schema: {$ref: '#/components/schemas/UpdateEntityTemplate'}
        required: true
        description: |-
          Request parameters for changing either a template's name or any of
            the attributes it is designed to pre-populate.
      parameters:
      - schema: {type: string, format: uuid}
        name: entity-template-public-id
        required: true
        description: The unique ID of the template to be updated.
        in: path
      description: Update an entity template's name or its contents.
    get:
      operationId: getEntityTemplate
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/EntityTemplate'}
          description: Resource
      summary: Get Entity Template
      parameters:
      - schema: {type: string, format: uuid}
        name: entity-template-public-id
        required: true
        description: The unique ID of the entity template.
        in: path
      description: Get Entity Template returns information about a given entity template.
  /api/v3/milestones:
    post:
      operationId: createMilestone
      responses:
        '422': {description: Unprocessable}
        '201':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/Milestone'}
          description: Resource
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '403':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/UnusableEntitlementError'}
          description: ''
      summary: Create Milestone
      requestBody:
        content:
          application/json:
            schema: {$ref: '#/components/schemas/CreateMilestone'}
        required: true
      description: '(Deprecated: Use ''Create Objective'') Create Milestone allows you to create a new Milestone in Shortcut.'
    get:
      operationId: listMilestones
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema:
                items: {$ref: '#/components/schemas/Milestone'}
                type: array
          description: Resource
      summary: List Milestones
      description: '(Deprecated: Use ''List Objectives'') List Milestones returns a list of all Milestones and their attributes.'
  /api/v3/search/epics:
    get:
      operationId: searchEpics
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/MaxSearchResultsExceededError'}
          description: '**Either:** (1) Schema mismatch **or** (2) Maximum of 1000 search results exceeded '
        '200':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/EpicSearchResults'}
          description: Resource
      summary: Search Epics
      parameters:
      - schema: {minLength: 1, type: string}
        name: query
        required: true
        description: See our help center article on [search operators](https://help.shortcut.com/hc/en-us/articles/360000046646-Search-Operators)
        in: query
      - schema: {type: integer, format: int64}
        name: page_size
        required: false
        description: The number of search results to include in a page. Minimum of 1 and maximum of 250.
        in: query
      - schema:
          type: string
          enum: [full, slim]
        name: detail
        required: false
        description: |-
          The amount of detail included in each result item.
             "full" will include all descriptions and comments and more fields on
             related items such as pull requests, branches and tasks.
             "slim" omits larger fulltext fields such as descriptions and comments
             and only references related items by id.
             The default is "full".
        in: query
      - schema: {type: string}
        name: next
        required: false
        description: The next page token.
        in: query
      - schema:
          items:
            type: string
            enum: [story, milestone, epic, iteration, objective]
          type: array
        name: entity_types
        explode: true
        required: false
        description: 'A collection of entity_types to search. Defaults to story and epic. Supports: epic, iteration, objective, story.'
        in: query
      description: Search Epics lets you search Epics based on desired parameters. Since ordering of stories can change over time (due to search ranking decay, new Epics being created), the `next` value from the previous response can be used as the path and query string for the next page to ensure stable ordering.
  /api/v3/iterations/{iteration-public-id}/stories:
    get:
      operationId: listIterationStories
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema:
                items: {$ref: '#/components/schemas/StorySlim'}
                type: array
          description: Resource
      summary: List Iteration Stories
      parameters:
      - schema: {type: integer, format: int64}
        name: iteration-public-id
        required: true
        description: The unique ID of the Iteration.
        in: path
      - schema: {type: boolean}
        name: includes_description
        required: false
        description: A true/false boolean indicating whether to return Stories with their descriptions.
        in: query
      description: Get a list of all Stories in an Iteration.
  /api/v3/epics/{epic-public-id}/comments/{comment-public-id}:
    delete:
      operationId: deleteEpicComment
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '204': {description: No Content}
      summary: Delete Epic Comment
      parameters:
      - schema: {type: integer, format: int64}
        name: epic-public-id
        required: true
        description: The ID of the associated Epic.
        in: path
      - schema: {type: integer, format: int64}
        name: comment-public-id
        required: true
        description: The ID of the Comment.
        in: path
      description: This endpoint allows you to delete a Comment from an Epic.
    put:
      operationId: updateEpicComment
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/ThreadedComment'}
          description: Resource
      summary: Update Epic Comment
      requestBody:
        content:
          application/json:
            schema: {$ref: '#/components/schemas/UpdateComment'}
        required: true
      parameters:
      - schema: {type: integer, format: int64}
        name: epic-public-id
        required: true
        description: The ID of the associated Epic.
        in: path
      - schema: {type: integer, format: int64}
        name: comment-public-id
        required: true
        description: The ID of the Comment.
        in: path
      description: This endpoint allows you to update a threaded Comment on an Epic.
    post:
      operationId: createEpicCommentComment
      responses:
        '422': {description: Unprocessable}
        '201':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/ThreadedComment'}
          description: Resource
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
      summary: Create Epic Comment Comment
      requestBody:
        content:
          application/json:
            schema: {$ref: '#/components/schemas/CreateCommentComment'}
        required: true
      parameters:
      - schema: {type: integer, format: int64}
        name: epic-public-id
        required: true
        description: The ID of the associated Epic.
        in: path
      - schema: {type: integer, format: int64}
        name: comment-public-id
        required: true
        description: The ID of the parent Epic Comment.
        in: path
      description: This endpoint allows you to create a nested Comment reply to an existing Epic Comment.
    get:
      operationId: getEpicComment
      responses:
        '422': {description: Unprocessable}
        '404': {description: Resource does not exist}
        '400': {description: Schema mismatch}
        '200':
          content:
            application/json:
              schema: {$ref: '#/components/schemas/ThreadedComment'}
          description: Resource
      summary: Get Epic Comment
      parameters:
      - schema: {type: integer, format: int64}
        name: epic-public-id
        required: true
        description: The ID of the associated Epic.
        in: path
